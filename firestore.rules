rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid;
    }

    function validHabit(habitId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'name',
          'history',
          'color',
          'status',
          'emoji',
          'targetType',
          'weeklyTarget',
          'createdAt'
        ])
        && request.resource.data.id == habitId
        && request.resource.data.name is string
        && request.resource.data.history is list
        && request.resource.data.color is string
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['active', 'mastered'])
        && request.resource.data.emoji is string
        && (!request.resource.data.keys().hasAny(['targetType']) || request.resource.data.targetType in ['daily', 'weekly'])
        && (!request.resource.data.keys().hasAny(['weeklyTarget']) || (
          request.resource.data.weeklyTarget is number
          && request.resource.data.weeklyTarget >= 1
          && request.resource.data.weeklyTarget <= 7
        ))
        && request.resource.data.createdAt is number;
    }

    function validNotificationSettings(settingId) {
      return settingId == 'dailyReminder'
        && request.resource.data.keys().hasOnly([
          'enabled',
          'reminderTime',
          'notificationPermission',
          'language',
          'timezone',
          'updatedAt',
          'fcmToken',
          'fcmTokenUpdatedAt'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.reminderTime is string
        && request.resource.data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.notificationPermission in ['default', 'granted', 'denied', 'unsupported']
        && request.resource.data.language in ['en', 'lt']
        && request.resource.data.timezone is string
        && request.resource.data.updatedAt is number
        && (!request.resource.data.keys().hasAny(['fcmToken']) || request.resource.data.fcmToken is string)
        && (!request.resource.data.keys().hasAny(['fcmTokenUpdatedAt']) || request.resource.data.fcmTokenUpdatedAt is number);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validUserProfile(userId);

      match /habits/{habitId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHabit(habitId);
      }

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validNotificationSettings(settingId);
      }
    }

    match /habits/{habitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
